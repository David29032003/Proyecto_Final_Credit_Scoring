import sys
sys.path.append("./src")
import pandas as pd
import matplotlib.pyplot as plt
import eda

pd.setoption("display.maxcolumns", 50)

df = pd.readcsv("../data.csv", parsedates=["observation_date"])
pop = eda.tomodelable(df)  # outcomeavailable_flag == 1
globalrate = eda.overallbad_rate(pop)
print(f"Total: {len(df)} | N modelable PD: {len(pop)} | Bad rate global: {global_rate:.2%}")

%% [markdown]

1. Bad rate global y composición de cartera

